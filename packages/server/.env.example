PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql://kitchenasty:kitchenasty@localhost:5432/kitchenasty

# Required. The server refuses to start without it. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP for transactional mail (order confirmations, deletion requests).
# Falls back to SiteSettings.mailSettings from the admin UI when set there.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Inka <noreply@example.com>"
# Inbox that receives public account-deletion requests (defaults to EMAIL_FROM).
DELETION_NOTIFY_EMAIL=

# Geocode proxy (/api/geocode). With GOOGLE_MAPS_API_KEY set it uses the
# Google Geocoding API (production; needs billing enabled on the Google
# Cloud project). Without it, falls back to keyless OSM Nominatim (dev),
# which requires an identifying User-Agent.
GOOGLE_MAPS_API_KEY=
GEOCODE_REGION=de
GEOCODE_USER_AGENT="kitchenasty-inka/1.0 (+https://inka.kitchenasty.com)"
